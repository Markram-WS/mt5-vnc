# Template for the PostgREST test database credentials.
#
# The kind overlay generates the real Secret from a gitignored env file next to
# its kustomization (scripts/kind-up.sh creates it on first run, mode 0600, and
# never prints the password):
#
#   deploy/overlays/kind-dev/postgrest-secrets.env
#
# Copy this file there only if you want to choose the values yourself, then
# re-run `kubectl apply -k deploy/overlays/kind-dev` (and restart the pods).
#
# BOTH keys are read from the same Secret `postgrest-db`: the role the postgres
# entrypoint creates and the role PostgREST connects as (PGRST_DB_ANON_ROLE
# expands POSTGRES_USER), so keep them consistent.
#
# The password is embedded in PGRST_DB_URI, so keep it URL-safe (hex is ideal):
# `/`, `:`, `@`, `?` or `#` would have to be percent-encoded inside the URI.
#
# On the Talos cluster this Secret comes from Vault instead (properties
# POSTGRES_USER + POSTGRES_PASSWORD of secret/mt5) — see ./talos/externalsecret.yaml.
POSTGRES_USER=mt5
POSTGRES_PASSWORD=change-me-url-safe-password
