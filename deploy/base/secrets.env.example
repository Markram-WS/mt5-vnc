# Copy to deploy/base/secrets.env and replace every placeholder before applying.
#
# scripts/kind-up.sh does this automatically on its first run for the selected
# mode: it reads MT5_VNC_USER / MT5_VNC_PASSWORD / MT5_SERVER / MT5_ACCOUNT /
# MT5_PASSWORD out of <mode>/.env (grep/cut, never `source`), writes the file
# with mode 0600 and never prints the values.
#
# Empty MT5_SERVER / MT5_ACCOUNT / MT5_PASSWORD are acceptable: start.sh then
# launches MT5 without the /login arguments.
CUSTOM_USER=mt5vnc
PASSWORD=change-me-vnc-password
MT5_SERVER=VantageMarkets-Demo
MT5_ACCOUNT=00000000
MT5_PASSWORD=change-me-mt5-password
