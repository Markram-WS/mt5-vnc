# Template for the kind overlays' generated secrets.env.
#
# scripts/kind-up.sh writes deploy/overlays/<mode>/secrets.env on first run from
# <mode>/.env (grep, never `source`) and never prints the values. Only the VNC
# pair is a real credential here: MT5 logs in from its login profile (dev: the
# host-mounted Config dir, prod: seeded from MinIO by fetch-profile), so the
# MT5_* keys are written EMPTY and any old value is blanked on every run.
CUSTOM_USER=mt5vnc
PASSWORD=change-me-vnc-password
MT5_SERVER=
MT5_ACCOUNT=
MT5_PASSWORD=
