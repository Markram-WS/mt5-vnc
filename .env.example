# Template for the ONE local secret source: copy to .env (repo root, gitignored)
# and fill in the values. scripts/secrets.sh reads it with grep/cut — the file is
# never sourced, so it must stay plain KEY=VALUE.
#
# These six keys are the local counterpart of Vault secret/mt5 plus the dev-only
# VNC pair. Nothing else belongs here: non-secret configuration lives in
# ConfigMap mt5-env (deploy/base/configmap.yaml).
#
# docs/secrets.md explains what each key becomes in the cluster.
#
#   cp .env.example .env && chmod 600 .env
#   ./scripts/secrets.sh check
#   ./scripts/secrets.sh apply

# KasmVNC login for the dev pod (Secret mt5/mt5-secrets as CUSTOM_USER/PASSWORD).
MT5_VNC_USER=
MT5_VNC_PASSWORD=

# PostgreSQL role for the PostgREST test fixture (Secret mt5-data/postgrest-db).
# The role is not really a secret; the password is embedded verbatim in
# PGRST_DB_URI, so keep it URL-safe (hex is ideal): `/`, `:`, `@`, `?` or `#`
# would have to be percent-encoded. Generate one with:
#   openssl rand -hex 32
POSTGRES_USER=mt5
POSTGRES_PASSWORD=

# MinIO S3 keys, read by the operator's one-time rclone copy and by prod's
# fetch-profile (through Vault). Dev itself never talks to MinIO.
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
