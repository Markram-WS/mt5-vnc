# MT5 Docker & Kubernetes Configuration Example
# Copy this file to .env and fill in your values

# ============================================================================
# MT5 Credentials (for auto-login - required for production)
# ============================================================================
# Set these three variables together to enable MT5 auto-login via command-line
# Leave empty if you prefer to login manually via VNC
MT5_SERVER=""                                   # Optional: Full server address (server:port)
MT5_ACCOUNT=""                                  # Required: Your MT5 account number
MT5_PASSWORD=""                                 # Required: Your MT5 account password

# ============================================================================
# API Configuration
# ============================================================================
# Enable/disable mt5linux API server (default: true)
# Set to "false" to run MT5 without Python API
ENABLE_MT5LINUX_API="true"

# ============================================================================
# Mode Selection
# ============================================================================
# HEADLESS mode: true for production/K8s, false for development with VNC
# For Kubernetes deployments, this is typically set via ConfigMap
HEADLESS="false"

# ============================================================================
# VNC Credentials (development mode only)
# ============================================================================
# Credentials for web-based VNC access (not used in headless mode)
MT5_VNC_USER="your_vnc_username"
MT5_VNC_PASSWORD="your_vnc_password"

# ============================================================================
# VNC Configuration (development mode only)
# ============================================================================
# VNC screen resolution (format: WIDTHxHEIGHT)
VNC_RESOLUTION="1280x800"

# ============================================================================
# System Configuration
# ============================================================================
# Rootless Podman compatibility
LSIO_NON_ROOT_USER="true"

# ============================================================================
# Kubernetes Deployment Notes
# ============================================================================
# For Kubernetes deployments:
# - COMPANY_ENV, COMPANY_REGION, MT5_BROKER_SERVER, MT5_BROKER_PORT go in ConfigMap
# - MT5_ACCOUNT, MT5_PASSWORD, MT5_SERVER go in Secret
# - HEADLESS defaults to "true" in Kubernetes ConfigMap
# - Use k8s/ manifests for deployment
#
# Local development:
# - Set HEADLESS="false" for VNC access
# - Configure MT5 credentials for auto-login
# - Use docker-compose.yml for local testing