# Production MT5 - Environment Configuration Example
# Copy to .env and fill in your real values (.env is gitignored)
#
# ตัวอย่างค่า Environment สำหรับ MT5 Production
# คัดลอกเป็น .env แล้วกรอกค่าจริงของคุณ (.env ไม่ถูกทำ Git)

# ============================================================================
# MT5 Credentials (for auto-login - required)
# ****************************************************************************
# Note: If using a shared PV that already holds a logged-in session (login
# persists in the Wine prefix), MT5 auto-connects on boot and no GUI/xdotool
# login is needed (prod image is GUI-free, no xdotool).
# ****************************************************************************
MT5_SERVER="VantageMarkets-Demo"       # Server name or "host:port"
MT5_ACCOUNT=""                          # Your MT5 account number
MT5_PASSWORD=""                         # Your MT5 account password

# ============================================================================
# API Configuration
# ============================================================================
# mt5linux API server (port 8001). Leave true for headless operation.
ENABLE_MT5LINUX_API="true"

# ============================================================================
# Auto-start EA  (dynamic: เปลี่ยนได้จาก .env โดยไม่ต้อง rebuild image)
# ----------------------------------------------------------------------------
# ตัวเดียวกับระบบ dev: start.sh เขียน startup.ini [StartUp] Expert/Symbol/Period
# แล้ว MT5 อ่านตอน boot ทุกครั้ง — ใช้ EA ตัวไหน / สัญลักษณ์ / timeframe ไหนก็ได้
# ที่อยู่ใน MQL5/Experts (วาง .ex5/.mq5 ลง prod/mql5/Experts/)
# ============================================================================
MT5_AUTO_START_EA="TestAutoStartEA"     # EA file in MQL5/Experts (ไม่ต้องมี .ex ต่อท้าย)
MT5_AUTO_START_SYMBOL="EURUSD"          # Chart symbol (อัปเดตได้)
MT5_AUTO_START_PERIOD="H1"              # Timeframe: M1, H1, D1, ...

# ============================================================================
# Log Retention  (dynamic: ไม่ต้อง rebuild image)
# ----------------------------------------------------------------------------
# ลบ MT5 log ที่เก่ากว่า LOG_RETENTION_DAYS วัน โดยวิ่งตรวจทุก LOG_RETENTION_INTERVAL
# วินาที (ค่าเริ่มต้นรายวัน). ใช้ 0 = ปิดการเก็บ (ไม่ลบ). ครอบคลุมทั้ง
# MQL5/Logs, Experts/Indicators Logs, Tester logs และ terminal root logs.
# ============================================================================
LOG_RETENTION_DAYS="7"                  # ลบ .log เก่ากว่า 7 วัน (0 = ปิด)
LOG_RETENTION_INTERVAL="86400"          # ตรวจทุก 24 ชม. (หน่วยวินาที)

# ============================================================================
# Company / Platform
# ============================================================================
COMPANY_ENV="production"
COMPANY_REGION="us-east-1"
